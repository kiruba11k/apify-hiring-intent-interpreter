{
    "actorSpecification": 1,
    "name": "hiring-intent-interpreter",
    "title": "Hiring Intent Interpreter",
    "description": "Converts job postings into structured B2B technology buying intent signals. Classifies companies by tech category (ERP, Cloud, Data, Security, QA, AI), intent type, and intent score.",
    "version": "1.0.0",
    "buildTag": "latest",
    "dockerfile": "./Dockerfile",
    "readme": "./README.md",
    "input": "./input_schema.json",
    "storages": {
        "dataset": {
            "title": "Intent Signals",
            "description": "One record per job posting with intent classification and score",
            "views": {
                "overview": {
                    "title": "Intent Overview",
                    "transformation": {
                        "fields": [
                            "company_name",
                            "job_title",
                            "intent_categories",
                            "intent_type",
                            "intent_score",
                            "intent_strength",
                            "reasoning",
                            "signals",
                            "boost_applied",
                            "historical_job_count",
                            "interpreted_at"
                        ]
                    },
                    "display": {
                        "component": "table",
                        "properties": {
                            "company_name": { "label": "Company" },
                            "job_title": { "label": "Job Title" },
                            "intent_categories": { "label": "Categories", "format": "array" },
                            "intent_type": { "label": "Intent Type" },
                            "intent_score": { "label": "Score (0-100)", "format": "number" },
                            "intent_strength": { "label": "Strength" },
                            "reasoning": { "label": "Reasoning" }
                        }
                    }
                }
            }
        }
    }
}
